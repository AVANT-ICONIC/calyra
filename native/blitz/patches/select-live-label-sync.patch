+    pub fn get_node_mut(&mut self, node_id: NodeId) -> Option<&mut Node> {
+        self.nodes.get_mut(node_id)
+    }
+
+    /// CALYRA experimental in-place select-label repaint. This uses the
+    /// existing Parley buffer from the select-label proof, not a final widget.
+    /// It intentionally never touches markup, selected attrs or DOM node ids.
+    pub fn calyra_sync_select_label(&mut self, select_id: NodeId, label: &str) {
+        let Some(node) = self.nodes.get_mut(select_id) else { return };
+        let Some(element) = node.element_data_mut() else { return };
+        let Some(input) = element.text_input_data_mut() else { return };
+        let mut font_ctx = self.font_ctx.lock().unwrap();
+        input.set_text(&mut font_ctx, &mut self.layout_ctx, label);
+        self.shell_provider.request_redraw();
+    }
+
+    pub fn get_focussed_node_id(&self) -> Option<NodeId> {
         self.focus_node_id
             .or(self.try_root_element().map(|el| el.id))
     }
