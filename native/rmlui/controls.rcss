/* ADAPTED RCSS, NOT direct CSS support. Colors copied from fixtures/reference.css;
   markup and rules simplified for RmlUi layout semantics. */
body { background-color: #0e1319; color: #e8e9e4; font-family: Arial; font-size: 15px; margin: 0; }
.masthead { display: flex; justify-content: space-between; align-items: center; height: 84px; padding: 0 48px; border-bottom: 1px solid #33414f; }
.brand { color: #c6db74; font-size: 26px; font-weight: bold; }
.brand-sub { font-size: 10px; color: #9ba6b2; margin-left: 16px; }
.head-meta { color: #9ba6b2; font-size: 11px; }
.main { max-width: 880px; margin: 0 auto; padding: 50px 44px; }
.eyebrow { color: #c6db74; font-size: 11px; }
h1 { font-size: 49px; color: #e8e9e4; margin: 16px 0 18px; }
.lead { color: #9ba6b2; line-height: 1.6; max-width: 600px; margin-bottom: 36px; }
.control-grid { display: flex; gap: 22px; }
.field { width: 49%; }
.field label { display: block; margin-bottom: 10px; font-size: 13px; }
.field input, .field select { box-sizing: border-box; height: 48px; width: 100%; color: #e8e9e4; background-color: #181f28; border: 1px solid #43505c; border-radius: 9px; padding: 9px 14px; }
.actions { display: flex; gap: 12px; margin-top: 32px; }
.action { border: 1px solid #526172; border-radius: 8px; padding: 13px 20px; font-size: 13px; }
.primary { background-color: #c6db74; color: #141c11; border-color: #c6db74; }
.secondary { background-color: #121922; color: #e8e9e4; }
#action-status { margin-top: 25px; color: #c6db74; font-size: 12px; }
.footnote { margin-top: 60px; color: #9ba6b2; font-size: 10px; }
